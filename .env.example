TG_API_ID=
TG_API_HASH=
TG_SESSION=
DB_PATH=
# Alert delivery: log or telegram (empty means log)
NOTIFIER=log
# Bot token from @BotFather, required when NOTIFIER=telegram
ALERT_BOT_TOKEN=
# Chat that receives alerts; empty uses your own account (open the bot and press Start).
# A group chat id works only if the bot is a member of that group.
ALERT_CHAT_ID=
WEB_PASSWORD_HASH=
WEB_SECRET_KEY=
# Set to 1 when served over HTTPS (Railway): marks the session cookie Secure
WEB_HTTPS_ONLY=
LOG_LEVEL=
# RETENTION_DAYS=90
# APP_TIMEZONE=America/Sao_Paulo
